# Backend environment variables
# Copy this file to .env and fill in your values.
# Never commit your real .env to version control.

# Runtime connection — use the POOLED Prisma Postgres host.
# Set this in Vercel → Project → Settings → Environment Variables.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Direct host — only the Prisma CLI uses it (npx prisma db push / migrate).
# Same credentials, host without "pooled.". Not needed on Vercel.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Optional pool tuning per serverless instance (defaults shown).
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20
# PRISMA_CONNECT_TIMEOUT=15

# Port for the NestJS server (local only; ignored on Vercel)
PORT=3000

# Origin of the frontend (used for CORS)
FRONTEND_URL=http://localhost:3001
